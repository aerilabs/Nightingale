{
  "author": "izzy.eth",
  "name": "nightingale",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-customizable"
    },
    "cz-customizable": {
      "config": "./.cz-config.cjs"
    }
  },
  "lint-staged": {
    "*.rs": [
      "cargo fmt --all",
      "cargo fmt --all -- --check"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@types/bun": "latest",
    "commitizen": "^4.3.2",
    "cz-customizable": "^7.5.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "scripts": {
    "commit": "bun run cz",
    "prepare": "husky"
  }
}
